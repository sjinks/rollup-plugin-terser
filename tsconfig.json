{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "noEmitOnError": true,
        "rootDirs": ["src", "test"],
        "outDir": "./dist",
        "sourceMap": true,
        "declaration": true,
        "removeComments": true,
        "strict": true,
        "isolatedModules": true,
        "noUnusedLocals": true,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "types": ["node"]
    },
    "compileOnSave": true
}
